{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Periplus Travel Request",
  "type": "object",
  "required": [
    "destination",
    "start_date",
    "end_date",
    "journey"
  ],
  "properties": {
    "destination": {
      "type": "string",
      "minLength": 2
    },
    "country": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "flights": {
      "type": "object",
      "required": [
        "outbound",
        "return"
      ],
      "properties": {
        "outbound": {
          "$ref": "#/$defs/flight"
        },
        "return": {
          "$ref": "#/$defs/flight"
        }
      },
      "additionalProperties": false,
      "deprecated": true,
      "description": "Legacy compatibility; normalized to journey with mode=flight if journey omitted."
    },
    "hotel": {
      "description": "User-provided hotel information, independently optional. An omitted hotel triggers researched recommendations, not imaginary bookings.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "name_local": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "reservation_reference": {
          "type": "string"
        },
        "check_in": {
          "type": "string"
        },
        "check_out": {
          "type": "string"
        },
        "status": {
          "enum": [
            "booked",
            "planned",
            "recommendation",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "customization": {
      "type": "object",
      "properties": {
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_visit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pace": {
          "enum": [
            "relaxed",
            "balanced",
            "intensive"
          ]
        },
        "walking_limit": {
          "type": "string"
        },
        "transport_preferences": {
          "type": "string"
        },
        "food_preferences": {
          "type": "string"
        },
        "photo_preferences": {
          "type": "string"
        },
        "budget": {
          "type": "string"
        },
        "companion_notes": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "default": "zh-CN",
          "description": "Requested narrative output language (any BCP-47 language tag); input can be in any language."
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "md",
              "docx",
              "pdf"
            ]
          },
          "default": [
            "docx",
            "pdf"
          ]
        },
        "notes": {
          "type": "string"
        },
        "name_languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "zh-CN",
            "en",
            "local"
          ]
        },
        "pronunciation": {
          "type": "string",
          "default": "verified-local-script-and-romanization"
        }
      },
      "additionalProperties": true
    },
    "journey": {
      "type": "object",
      "description": "Arrival and departure can each use any mode, including multimodal legs.",
      "required": [
        "outbound",
        "return"
      ],
      "properties": {
        "outbound": {
          "allOf": [
            {
              "$ref": "#/$defs/journey_leg"
            },
            {
              "required": [
                "origin"
              ]
            }
          ]
        },
        "return": {
          "allOf": [
            {
              "$ref": "#/$defs/journey_leg"
            },
            {
              "required": [
                "destination"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "flight": {
      "type": "object",
      "required": [
        "flight_number"
      ],
      "properties": {
        "flight_number": {
          "type": "string",
          "minLength": 2
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "departure_airport": {
          "type": "string"
        },
        "arrival_airport": {
          "type": "string"
        },
        "departure_local_time": {
          "type": "string"
        },
        "arrival_local_time": {
          "type": "string"
        },
        "departure_terminal": {
          "type": "string"
        },
        "arrival_terminal": {
          "type": "string"
        },
        "status": {
          "enum": [
            "booked",
            "planned",
            "unspecified"
          ]
        }
      },
      "additionalProperties": true
    },
    "journey_leg": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "flight",
            "rail",
            "bus",
            "ferry",
            "drive",
            "mixed",
            "other"
          ]
        },
        "service": {
          "type": "string",
          "description": "Optional flight/train/ferry number, operator or route name; not required if unknown"
        },
        "operator": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "description": "Physical point where this journey leg starts; mandatory on outbound. Do not assume outbound origin matches return destination."
        },
        "destination": {
          "type": "string",
          "description": "Physical final point of this journey leg; mandatory on return. May differ from outbound origin."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "departure_local_time": {
          "type": "string"
        },
        "arrival_local_time": {
          "type": "string"
        },
        "departure_terminal": {
          "type": "string"
        },
        "arrival_terminal": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "boarding_point": {
          "type": "string"
        },
        "reservation_status": {
          "enum": [
            "booked",
            "planned",
            "unknown"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journey_segment"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "journey_segment": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "flight",
            "rail",
            "bus",
            "ferry",
            "drive",
            "walk",
            "taxi",
            "other"
          ]
        },
        "service": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "departure_local_time": {
          "type": "string"
        },
        "arrival_local_time": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
